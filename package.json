{
  "name": "playdesign-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Playdesign Business Operating System",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/lib/video-spec.test.ts worker/video-scene-revision.test.ts",
    "typecheck": "tsc --noEmit",
    "cf:dev": "npm run build && wrangler dev --port 8788",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply office-crm --local",
    "db:migrate:remote": "wrangler d1 migrations apply office-crm --remote",
    "db:seed:local": "wrangler d1 execute office-crm --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute office-crm --remote --file=seed/seed.sql"
  },
  "dependencies": {
    "@remotion/player": "^4.0.540",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^8.3.6",
    "wrangler": "^4.157.0"
  }
}
